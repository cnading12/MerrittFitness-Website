# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Supabase
SUPABASE_URL=https://xxx.supabase.co
# SERVICE ROLE key — required. This is what the server authenticates with, and
# it BYPASSES Row Level Security, which is what lets RLS be locked down to
# deny-all (see scripts/migrations/2026_enable_rls_lockdown.sql).
#   - It is a SECRET. Never prefix it with NEXT_PUBLIC_, never put it in a
#     client component, never commit it.
#   - Set this and deploy BEFORE running the RLS migration, or booking breaks.
SUPABASE_SERVICE_ROLE_KEY=xxx
# Anon key — only a fallback for deployments that haven't set the service-role
# key yet. Once RLS is enabled this key can no longer read or write anything,
# which is the point: it is designed to be public and must not be trusted.
SUPABASE_ANON_KEY=xxx

# Resend
RESEND_API_KEY=re_xxx

# Google Calendar (service account)
GOOGLE_CLIENT_EMAIL=xxx@xxx.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID=xxx@group.calendar.google.com

# Vercel Cron (shared secret validated by /api/cron/* handlers)
CRON_SECRET=xxx

# Admin trigger endpoint (x-admin-secret header for /api/admin/*)
ADMIN_API_SECRET=xxx

# Ops distribution list for recurring billing emails.
#   - Monthly-billing roll-up is sent to both addresses in a single send
#     (one thread, both inboxes).
#   - Every client-facing recurring billing email (monthly billing invoice,
#     recurring setup confirmation) BCCs both addresses.
# If one is missing, the sender falls back to the one that is set and logs
# a warning. If both are missing, the roll-up is skipped and client-facing
# emails go out without BCC.
OPS_EMAIL_MANAGER=manager@merrittwellness.net
OPS_EMAIL_CLIENT_SERVICES=clientservices@merrittwellness.net

# ---------------------------------------------------------------------------
# PROMO CODES
#
# The code strings themselves — treat them as credentials, not settings.
# PROMO_CODE_COMP comps a booking 100%: no Stripe, no card, confirmed on the
# spot, written to the live Google Calendar. Anyone holding it can rent the
# venue for free.
#
# They live here (and in the Vercel dashboard) rather than in source because
# this repository is PUBLIC: a code committed to a .js file is readable at
# github.com, and stays readable in the git history after it is deleted. That
# is how two generations of codes were burned.
#
# Rotating one is a dashboard edit plus a redeploy — no code change, no commit.
# Suggested shape: a MERRITT-<ROLE>- prefix plus 8 characters drawn from a
# 31-character alphabet with 0/O and 1/I/L removed, so nothing is confusable
# when read aloud or typed off an email (~40 bits). Combined with the
# 10-guesses-per-minute cap on /api/validate-promo, guessing one is not a
# realistic attack.
#
# Leaving one unset is safe: that role simply has no valid code (fail closed).
# ---------------------------------------------------------------------------
PROMO_CODE_PARTNER=          # 20% partnership discount; exempts recurring partners from staff coverage
PROMO_CODE_COMP=             # 100% off, no payment collected, self-confirming
PROMO_CODE_SPONSOR=          # venue comped but staffing still billed
# Unlocks the weekday 8 AM - 4 PM window otherwise held for Merritt Workspace
# next door, and comps staff coverage (no Facility Host, no onboarding fee).
# Venue time is NOT discounted - this one is an access key, not a price cut.
# Issue it after talking to the renter: the whole point is that a person, not
# a form, decides whether an event is quiet enough to sit beside a workday.
# All four codes above unlock daytime; this is the one that ONLY does that.
PROMO_CODE_DAYTIME=          # weekday daytime access; staff coverage comped, venue time billed
